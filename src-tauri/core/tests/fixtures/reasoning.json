{
  "module": "reasoning",
  "cases": [
    {
      "name": "reasoning：无 reasoning 字段",
      "op": "reasoning.reasoningEfforts",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model"
        }
      },
      "expected": {}
    },
    {
      "name": "reasoning：有 reasoning 但无 variants",
      "op": "reasoning.reasoningEfforts",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true
        }
      },
      "expected": {}
    },
    {
      "name": "reasoning：medium/high 映射到 fast/deep",
      "op": "reasoning.reasoningEfforts",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true,
          "variants": {
            "fast": {
              "reasoningEffort": "medium"
            },
            "deep": {
              "reasoningEffort": "high"
            }
          }
        }
      },
      "expected": {
        "medium": "fast",
        "high": "deep"
      }
    },
    {
      "name": "reasoning：disabled 与非法 effort 被过滤",
      "op": "reasoning.reasoningEfforts",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "dead": {
              "disabled": true,
              "reasoningEffort": "high"
            },
            "weird": {
              "reasoningEffort": "ultra"
            },
            "empty": {}
          }
        }
      },
      "expected": {
        "none": "none",
        "low": "low"
      }
    },
    {
      "name": "reasoning：reasoning=false 时 variants 被忽略",
      "op": "reasoning.reasoningEfforts",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": false,
          "variants": {
            "fast": {
              "reasoningEffort": "low"
            }
          }
        }
      },
      "expected": {}
    },
    {
      "name": "reasoning：无 variants 时的能力声明",
      "op": "reasoning.workBuddyReasoning",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true
        }
      },
      "expected": {
        "supportsReasoning": true,
        "onlyReasoning": true,
        "reasoning": {
          "supportedEfforts": [],
          "canDisableThinking": false
        }
      }
    },
    {
      "name": "reasoning：不支持推理时返回 false",
      "op": "reasoning.workBuddyReasoning",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model"
        }
      },
      "expected": {
        "supportsReasoning": false
      }
    },
    {
      "name": "reasoning：含 none 时可关闭思考",
      "op": "reasoning.workBuddyReasoning",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            }
          }
        }
      },
      "expected": {
        "supportsReasoning": true,
        "onlyReasoning": false,
        "reasoning": {
          "supportedEfforts": [
            "none",
            "low"
          ],
          "defaultEffort": "low",
          "canDisableThinking": true
        }
      }
    },
    {
      "name": "reasoning：默认取 medium，否则第一个非 none",
      "op": "reasoning.workBuddyReasoning",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true,
          "variants": {
            "a": {
              "reasoningEffort": "xhigh"
            },
            "b": {
              "reasoningEffort": "max"
            }
          }
        }
      },
      "expected": {
        "supportsReasoning": true,
        "onlyReasoning": true,
        "reasoning": {
          "supportedEfforts": [
            "xhigh",
            "max"
          ],
          "defaultEffort": "xhigh",
          "canDisableThinking": false
        }
      }
    },
    {
      "name": "reasoning：medium 优先于第一个",
      "op": "reasoning.workBuddyReasoning",
      "input": {
        "model": {
          "id": "m1",
          "name": "Model",
          "reasoning": true,
          "variants": {
            "a": {
              "reasoningEffort": "xhigh"
            },
            "b": {
              "reasoningEffort": "medium"
            }
          }
        }
      },
      "expected": {
        "supportsReasoning": true,
        "onlyReasoning": true,
        "reasoning": {
          "supportedEfforts": [
            "xhigh",
            "medium"
          ],
          "defaultEffort": "medium",
          "canDisableThinking": false
        }
      }
    }
  ]
}
