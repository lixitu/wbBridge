      }
    },
    {
      "name": "parseWindowsProxy：地址没有端口时报端口无效",
      "op": "system_proxy.parseWindowsProxy",
      "input": {
        "settings": {
          "ProxyEnable": 1,
          "ProxyServer": "10.0.0.1"
        }
      },
      "expected": {
        "ok": false,
        "message": "Windows 系统代理端口无效"
