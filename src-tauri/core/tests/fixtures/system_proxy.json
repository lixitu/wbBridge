      "name": "parseWindowsProxy：ProxyEnable 为 0 时报错",
      "op": "system_proxy.parseWindowsProxy",
      "input": {
        "settings": {
          "ProxyEnable": 0,
          "ProxyServer": "10.0.0.1:8080"
        }
      },
      "expected": {
        "ok": false,
        "message": "请先启用 Windows 手动系统代理；暂不支持仅 PAC 配置"
      }
    },
    {
      "name": "parseWindowsProxy：ProxyEnable 为字符串 0 时报错",
      "op": "system_proxy.parseWindowsProxy",
