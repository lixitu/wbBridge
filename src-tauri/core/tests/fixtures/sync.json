    {
      "name": "syncModels：目标文件不存在时新建（不产生 .bak）",
      "op": "sync.syncModels",
      "input": {
        "file": "$BASE/models.json",
        "models": [
          {
            "id": "vendor/a",
            "name": "a",
            "context": 64000,
            "output": 8192
          }
        ],
        "endpoint": "http://127.0.0.1:8123/v1",
        "key": "sk-parity"
      },
      "expected": {
        "ok": true,
        "value": {
          "changed": true,
          "count": 1
        },
        "files": {
          "models.json": "[\n  {\n    \"id\": \"OC · a\",\n    \"name\": \"OC · a\",\n    \"vendor\": \"Custom\",\n    \"url\": \"http://127.0.0.1:8123/v1\",\n    \"apiKey\": \"sk-parity\",\n    \"supportsToolCall\": true,\n    \"supportsImages\": false,\n    \"supportsReasoning\": false,\n    \"buddyBridgeOwner\": \"buddy-bridge-v1\",\n    \"maxInputTokens\": 64000,\n    \"maxOutputTokens\": 8192\n  }\n]\n"
        }
      }
    },
    {
      "name": "syncModels：已有文档合并后写盘（Rust 侧不再留 .bak）",
      "op": "sync.syncModels",
      "files": {
        "models.json": {
          "json": {
            "models": [
              {
                "id": "my-model",
                "name": "自建模型"
