{
  "module": "sync",
  "doc": "sync.js 对拍用例：mergeModels 纯合并 + syncModels 的文件级行为（锁、原子写、无变化判定）。syncModels 会改动沙箱，Rust 侧为每个用例准备一份同内容的镜像沙箱，两侧各自跑完再比较「结果 + 全目录快照」。🔴 已知**有意的行为分叉**（2026-10-09 用户裁定）：JS 每次写盘前会留一份 `<配置文件>.buddy-bridge-<毫秒>.bak` 并在结果里回 `backup` 键，Rust 侧**不再产生任何备份**（备份从来没有读取方、面板也没有恢复入口，却按发布次数在用户目录里无限堆积），因此下面的 `expected.value` 没有 `backup` 键、`expected.files` 没有 `.bak` 文件；锁、二次读取、原子替换、无变化判定仍与 JS 逐字节对齐。",
  "cases": [
    {
      "name": "mergeModels：数组文档保留非本服务条目并追加新条目",
      "op": "sync.mergeModels",
      "input": {
        "document": [
          {
            "id": "own-1",
            "name": "自建模型"
          },
          {
            "id": "OC · 旧的",
            "buddyBridgeOwner": "buddy-bridge-v1"
          }
        ],
        "models": [
          {
            "id": "vendor/gpt",
            "name": "gpt",
            "context": 32000
          }
        ],
        "endpoint": "http://127.0.0.1:8123/v1",
        "key": "sk-parity"
      },
      "expected": {
        "ok": true,
        "value": [
          {
            "id": "own-1",
            "name": "自建模型"
          },
          {
            "id": "OC · gpt",
            "name": "OC · gpt",
            "vendor": "Custom",
            "url": "http://127.0.0.1:8123/v1",
            "apiKey": "sk-parity",
            "supportsToolCall": true,
            "supportsImages": false,
            "supportsReasoning": false,
            "buddyBridgeOwner": "buddy-bridge-v1",
            "maxInputTokens": 32000
          }
        ]
      }
    },
    {
      "name": "mergeModels：对象文档改写 models 与 availableModels（保留其余字段与键顺序）",
      "op": "sync.mergeModels",
      "input": {
        "document": {
          "models": [
            {
              "id": "mine",
              "name": "自建模型"
            },
            {
              "id": "OC · gpt",
              "name": "OC · gpt",
              "buddyBridgeOwner": "buddy-bridge-v1"
            }
          ],
          "availableModels": [
            "mine",
            "OC · gpt",
            "ghost",
            "mine"
          ],
          "currentModel": "mine",
          "extra": {
            "keep": true
          }
        },
        "models": [
          {
            "id": "vendor/gpt",
            "name": "gpt",
            "context": 32000,
            "output": 4096,
            "images": true,
            "reasoning": true,
            "variants": {
              "low": {
                "reasoningEffort": "low"
              },
              "off": {
                "disabled": true
              },
              "max": {
                "reasoningEffort": "max"
              }
            }
          }
        ],
        "endpoint": "https://api.example.com/v1",
        "key": "sk-1"
      },
      "expected": {
        "ok": true,
        "value": {
          "models": [
            {
              "id": "mine",
              "name": "自建模型"
            },
            {
              "id": "OC · gpt",
              "name": "OC · gpt",
              "vendor": "Custom",
              "url": "https://api.example.com/v1",
              "apiKey": "sk-1",
              "supportsToolCall": true,
              "supportsImages": true,
              "supportsReasoning": true,
              "onlyReasoning": true,
              "reasoning": {
                "supportedEfforts": [
                  "low",
                  "max"
                ],
                "defaultEffort": "low",
                "canDisableThinking": false
              },
              "buddyBridgeOwner": "buddy-bridge-v1",
              "maxInputTokens": 32000,
              "maxOutputTokens": 4096
            }
          ],
          "availableModels": [
            "mine",
            "ghost",
            "OC · gpt"
          ],
          "currentModel": "mine",
          "extra": {
            "keep": true
          }
        }
      }
    },
    {
      "name": "mergeModels：id 或 OC 名与既有条目冲突的新条目整体丢弃",
      "op": "sync.mergeModels",
      "input": {
        "document": {
