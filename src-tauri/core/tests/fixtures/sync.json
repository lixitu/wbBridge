        ],
        "endpoint": "http://x/v1",
        "key": "k"
      },
      "expected": {
        "ok": true,
        "value": {
          "models": [
            {
              "id": "OC · gpt"
            },
            {
              "id": "OC · taken"
            },
            {
              "id": "OC · ignored",
              "name": "OC · ignored",
              "vendor": "Custom",
              "url": "http://x/v1",
              "apiKey": "k",
              "supportsToolCall": true,
              "supportsImages": false,
              "supportsReasoning": false,
              "buddyBridgeOwner": "buddy-bridge-v1"
            },
            {
              "id": "OC · fresh",
              "name": "OC · fresh",
              "vendor": "Custom",
              "url": "http://x/v1",
              "apiKey": "k",
              "supportsToolCall": true,
              "supportsImages": false,
              "supportsReasoning": false,
              "buddyBridgeOwner": "buddy-bridge-v1"
            }
          ]
        }
      }
    },
    {
