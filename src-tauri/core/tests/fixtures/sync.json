      "expected": {
        "first": {
          "ok": true,
          "value": {
            "changed": true,
            "count": 1
          }
        },
        "second": {
          "ok": true,
          "value": {
            "changed": false,
            "count": 1
          }
        },
        "files": {
          "models.json": "[\n  {\n    \"id\": \"OC · c\",\n    \"name\": \"OC · c\",\n    \"vendor\": \"Custom\",\n    \"url\": \"http://127.0.0.1:8123/v1\",\n    \"apiKey\": \"sk-parity\",\n    \"supportsToolCall\": true,\n    \"supportsImages\": true,\n    \"supportsReasoning\": true,\n    \"onlyReasoning\": true,\n    \"reasoning\": {\n      \"supportedEfforts\": [],\n      \"canDisableThinking\": false\n    },\n    \"buddyBridgeOwner\": \"buddy-bridge-v1\"\n  }\n]\n"
        }
      }
    },
    {
      "name": "syncModels：requireExisting 且目标缺失时报 not_found，且不创建文件",
