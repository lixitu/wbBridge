              "vendor": "Custom",
              "url": "e",
              "apiKey": "k",
              "supportsToolCall": true,
              "supportsImages": false,
              "supportsReasoning": false,
              "buddyBridgeOwner": "buddy-bridge-v1"
            }
          ]
        }
      }
    },
    {
      "name": "mergeModels：空模型列表且未允许为空时整体报错",
      "op": "sync.mergeModels",
      "input": {
        "document": {
          "models": [
            {
              "id": "keep"
            }
          ]
        },
        "models": [],
        "endpoint": "e",
        "key": "k"
      },
      "expected": {
        "ok": false,
        "kind": "other",
        "message": "Empty model discovery; existing configuration preserved"
      }
    },
    {
      "name": "mergeModels：空模型列表但允许为空时保留既有条目",
      "op": "sync.mergeModels",
      "input": {
        "document": {
          "models": [
            {
              "id": "keep"
            }
          ]
        },
        "models": [],
        "allowEmpty": true,
        "endpoint": "e",
        "key": "k"
      },
      "expected": {
        "ok": true,
        "value": {
          "models": [
            {
              "id": "keep"
            }
          ]
