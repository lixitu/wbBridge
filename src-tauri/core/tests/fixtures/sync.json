              "OC · gpt-4o",
              "missing-one"
            ]
          }
        }
      },
      "input": {
        "file": "$BASE/models.json",
        "models": [
          {
            "id": "vendor/b",
            "name": "b",
            "context": 128000
          }
        ],
        "endpoint": "http://127.0.0.1:8123/v1",
        "key": "sk-parity"
      },
      "expected": {
        "ok": true,
        "value": {
          "changed": true,
          "count": 1
        },
        "files": {
          "models.json": "{\n  \"models\": [\n    {\n      \"id\": \"my-model\",\n      \"name\": \"自建模型\"\n    },\n    {\n      \"id\": \"OC · b\",\n      \"name\": \"OC · b\",\n      \"vendor\": \"Custom\",\n      \"url\": \"http://127.0.0.1:8123/v1\",\n      \"apiKey\": \"sk-parity\",\n      \"supportsToolCall\": true,\n      \"supportsImages\": false,\n      \"supportsReasoning\": false,\n      \"buddyBridgeOwner\": \"buddy-bridge-v1\",\n      \"maxInputTokens\": 128000\n    }\n  ],\n  \"availableModels\": [\n    \"my-model\",\n    \"missing-one\",\n    \"OC · b\"\n  ]\n}\n"
        }
      }
    },
    {
      "name": "syncModels：合并结果与既有文档一致时不写盘、不备份",
      "op": "sync.syncModels",
      "files": {
        "models.json": {
          "json": {
            "models": []
